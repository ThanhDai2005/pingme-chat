{
  "openapi": "3.0.0",
  "info": {
    "title": "PingMe Chat API",
    "version": "1.0.0",
    "description": "Tài liệu API cho hệ thống PingMe Chat"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local server v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "664a1b2c3d4e5f6a7b8c9d0e" },
          "username": { "type": "string", "example": "nguyenvana" },
          "email": { "type": "string", "format": "email", "example": "vana@gmail.com" },
          "displayName": { "type": "string", "example": "Nguyen Van A" },
          "avatarUrl": { "type": "string", "nullable": true, "example": "https://res.cloudinary.com/..." },
          "bio": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "fcmToken": { "type": "string", "nullable": true, "description": "Firebase Cloud Messaging token dùng để gửi push notification" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "MessageImage": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "example": "https://res.cloudinary.com/..." },
          "fileType": { "type": "string", "enum": ["image", "video", "file"], "example": "image" },
          "name": { "type": "string", "example": "photo.jpg" }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "conversationId": { "type": "string" },
          "senderId": { "type": "string" },
          "content": { "type": "string", "nullable": true },
          "imgUrl": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MessageImage" }
          },
          "isEdit": { "type": "boolean", "default": false },
          "isDelete": { "type": "boolean", "default": false },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "LastMessage": {
        "type": "object",
        "nullable": true,
        "properties": {
          "messageId": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "file"] },
          "content": { "type": "string", "nullable": true },
          "senderId": {
            "type": "object",
            "properties": {
              "_id": { "type": "string" },
              "displayName": { "type": "string" },
              "avatarUrl": { "type": "string", "nullable": true }
            }
          },
          "createdAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Participant": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "object",
            "properties": {
              "_id": { "type": "string" },
              "displayName": { "type": "string" },
              "avatarUrl": { "type": "string", "nullable": true }
            }
          },
          "joinAt": { "type": "string", "format": "date-time" }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "type": { "type": "string", "enum": ["direct", "group"] },
          "participants": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Participant" }
          },
          "group": {
            "type": "object",
            "nullable": true,
            "properties": {
              "name": { "type": "string" },
              "createdBy": { "type": "string" }
            }
          },
          "lastMessage": { "$ref": "#/components/schemas/LastMessage" },
          "lastMessageAt": { "type": "string", "format": "date-time" },
          "seenBy": {
            "type": "array",
            "items": { "type": "string" }
          },
          "unreadCounts": {
            "type": "object",
            "description": "Map: userId → số tin chưa đọc",
            "additionalProperties": { "type": "integer" }
          },
          "deletedAt": {
            "type": "object",
            "description": "Map: userId → thời điểm user xóa conversation",
            "additionalProperties": { "type": "string", "format": "date-time" }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "FriendRequest": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "from": { "$ref": "#/components/schemas/User" },
          "to": { "$ref": "#/components/schemas/User" },
          "message": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Friend": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "displayName": { "type": "string" },
          "username": { "type": "string" },
          "avatarUrl": { "type": "string", "nullable": true }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    { "name": "auth", "description": "Xác thực và phân quyền" },
    { "name": "user", "description": "Quản lý thông tin người dùng và FCM token" },
    { "name": "friend", "description": "Quản lý bạn bè và lời mời kết bạn" },
    { "name": "message", "description": "Quản lý tin nhắn" },
    { "name": "conversation", "description": "Quản lý hội thoại (direct, group)" }
  ],
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Đăng ký tài khoản mới",
        "tags": ["auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password", "email", "firstName", "lastName"],
                "properties": {
                  "username": { "type": "string", "example": "nguyenvana" },
                  "password": { "type": "string", "example": "123456" },
                  "email": { "type": "string", "format": "email", "example": "vana@gmail.com" },
                  "firstName": { "type": "string", "example": "Van A" },
                  "lastName": { "type": "string", "example": "Nguyen" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Đăng ký thành công" }
                  }
                }
              }
            }
          },
          "400": { "description": "Username hoặc email đã tồn tại, thiếu dữ liệu" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "summary": "Đăng nhập",
        "description": "Trả về accessToken trong body. RefreshToken được set vào HTTP-only cookie.",
        "tags": ["auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "nguyenvana" },
                  "password": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "User Nguyen Van A đã logged" },
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          },
          "400": { "description": "Thiếu username hoặc password" },
          "401": { "description": "Sai tài khoản hoặc mật khẩu" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/auth/signout": {
      "post": {
        "summary": "Đăng xuất",
        "description": "Xóa session và clear refreshToken cookie.",
        "tags": ["auth"],
        "security": [],
        "responses": {
          "200": {
            "description": "Đăng xuất thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Đăng xuất thành công" }
                  }
                }
              }
            }
          },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Làm mới Access Token",
        "description": "Dùng refreshToken trong cookie để lấy accessToken mới. Thời hạn accessToken là 30 phút.",
        "tags": ["auth"],
        "security": [],
        "responses": {
          "200": {
            "description": "Trả về accessToken mới",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "RefreshToken không tồn tại, không hợp lệ hoặc đã hết hạn" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Quên mật khẩu — Gửi OTP về email",
        "description": "OTP có hiệu lực trong 3 phút.",
        "tags": ["auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "vana@gmail.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã gửi OTP về email",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Đã gửi OTP về email" },
                    "email": { "type": "string", "example": "vana@gmail.com" }
                  }
                }
              }
            }
          },
          "400": { "description": "Thiếu email hoặc email không tồn tại" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/auth/verify-otp": {
      "post": {
        "summary": "Xác minh mã OTP",
        "description": "Nếu OTP đúng sẽ trả về resetToken (JWT, hiệu lực 10 phút).",
        "tags": ["auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "otp"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "otp": { "type": "string", "example": "482916" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP chính xác, trả về resetToken",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Mã otp chính xác" },
                    "resetToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "OTP sai hoặc đã hết hạn" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Đặt lại mật khẩu mới",
        "description": "Dùng resetToken trả về từ /verify-otp để đặt lại mật khẩu.",
        "tags": ["auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["resetToken", "newPassword", "confirmPassword"],
                "properties": {
                  "resetToken": { "type": "string" },
                  "newPassword": { "type": "string", "example": "newpass123" },
                  "confirmPassword": { "type": "string", "example": "newpass123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đổi mật khẩu thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Đổi mật khẩu thành công" }
                  }
                }
              }
            }
          },
          "400": { "description": "Mật khẩu không khớp hoặc resetToken hết hạn" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/user/detail": {
      "get": {
        "summary": "Lấy thông tin người dùng đang đăng nhập",
        "tags": ["user"],
        "responses": {
          "200": {
            "description": "Lấy thông tin user thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "lấy thông tin thành công" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "description": "Chưa đăng nhập hoặc token hết hạn" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/user/search": {
      "get": {
        "summary": "Tìm kiếm người dùng theo username hoặc displayName",
        "tags": ["user"],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Từ khóa tìm kiếm (username hoặc displayName)"
          }
        ],
        "responses": {
          "200": {
            "description": "Kết quả tìm kiếm (tối đa 10 kết quả)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_id": { "type": "string" },
                          "displayName": { "type": "string" },
                          "username": { "type": "string" },
                          "avatarUrl": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Thiếu từ khóa tìm kiếm" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/user/uploadAvatar": {
      "patch": {
        "summary": "Cập nhật ảnh đại diện (Avatar)",
        "description": "Upload ảnh lên Cloudinary, lưu URL vào database.",
        "tags": ["user"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["avatar"],
                "properties": {
                  "avatar": {
                    "type": "string",
                    "format": "binary",
                    "description": "File ảnh avatar mới"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật avatar thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Cập nhật avatar thành công" },
                    "avatarUrl": { "type": "string", "example": "https://res.cloudinary.com/..." }
                  }
                }
              }
            }
          },
          "400": { "description": "Không nhận được ảnh" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/user/profile": {
      "patch": {
        "summary": "Cập nhật thông tin profile cá nhân",
        "tags": ["user"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["displayName", "username", "email"],
                "properties": {
                  "displayName": { "type": "string", "example": "Nguyen Van A" },
                  "username": { "type": "string", "example": "nguyenvana" },
                  "email": { "type": "string", "format": "email" },
                  "phone": { "type": "string", "nullable": true, "example": "0901234567" },
                  "bio": { "type": "string", "nullable": true, "example": "Xin chào mọi người!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thông tin thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Cập nhật user thành công" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": { "description": "Thiếu trường bắt buộc hoặc username đã tồn tại" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/user/fcm-token": {
      "patch": {
        "summary": "Lưu FCM token để nhận push notification",
        "description": "Gọi sau khi user đồng ý nhận thông báo trên trình duyệt. Token này được dùng để gửi push notification khi user offline.",
        "tags": ["user"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fcmToken"],
                "properties": {
                  "fcmToken": {
                    "type": "string",
                    "description": "Firebase Cloud Messaging token lấy từ browser",
                    "example": "eXxxx:APA91bHPRgkFLJu..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lưu FCM token thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Lưu FCM token thành công" }
                  }
                }
              }
            }
          },
          "400": { "description": "Thiếu fcmToken trong body" },
          "401": { "description": "Chưa đăng nhập hoặc token hết hạn" },
          "500": { "description": "Lỗi hệ thống" }
        }
      },
      "delete": {
        "summary": "Xóa FCM token khi đăng xuất",
        "description": "Gọi khi user logout để ngừng nhận push notification. Token trong database sẽ được set về null.",
        "tags": ["user"],
        "responses": {
          "200": {
            "description": "Xóa FCM token thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Xóa FCM token thành công" }
                  }
                }
              }
            }
          },
          "401": { "description": "Chưa đăng nhập hoặc token hết hạn" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/friend": {
      "get": {
        "summary": "Lấy danh sách bạn bè",
        "tags": ["friend"],
        "responses": {
          "200": {
            "description": "Danh sách bạn bè",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "friends": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Friend" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/friend/requests": {
      "get": {
        "summary": "Lấy danh sách lời mời kết bạn (đã gửi và nhận)",
        "tags": ["friend"],
        "responses": {
          "200": {
            "description": "Danh sách lời mời",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sent": {
                      "type": "array",
                      "description": "Danh sách lời mời đã gửi",
                      "items": { "$ref": "#/components/schemas/FriendRequest" }
                    },
                    "receive": {
                      "type": "array",
                      "description": "Danh sách lời mời đã nhận",
                      "items": { "$ref": "#/components/schemas/FriendRequest" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      },
      "post": {
        "summary": "Gửi lời mời kết bạn",
        "tags": ["friend"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to"],
                "properties": {
                  "to": { "type": "string", "description": "ID của người nhận lời mời", "example": "664a1b2c3d4e5f6a7b8c9d0e" },
                  "message": { "type": "string", "description": "Lời chào kèm theo (tùy chọn)", "example": "Mình là bạn học của bạn!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
