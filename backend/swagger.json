    "/message/direct": {
      "post": {
        "summary": "Gửi tin nhắn trực tiếp (1-1)",
        "description": "Nếu chưa có conversation, sẽ tự động tạo mới. Sau khi gửi, backend phát socket 'new-message' và gửi FCM push notification nếu người nhận offline.",
        "tags": ["message"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipientId": {
                    "type": "string",
                    "description": "ID người nhận (bắt buộc nếu chưa có conversationId)",
                    "example": "664a1b2c3d4e5f6a7b8c9d0e"
                  },
                  "conversationId": {
                    "type": "string",
                    "description": "ID conversation (nếu đã tồn tại)"
                  },
                  "content": { "type": "string", "description": "Nội dung tin nhắn văn bản" },
                  "imgUrl": {
                    "type": "array",
                    "description": "Mảng các file đính kèm (ảnh, video, file)",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": { "type": "string" },
                        "fileType": { "type": "string", "enum": ["image", "video", "file"] },
                        "name": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Gửi tin nhắn thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "$ref": "#/components/schemas/Message" }
                  }
                }
              }
            }
          },
          "400": { "description": "Thiếu nội dung (content hoặc imgUrl)" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/message/group": {
      "post": {
        "summary": "Gửi tin nhắn vào nhóm",
        "description": "Sau khi gửi, backend phát socket 'new-message' và gửi FCM push notification đến các thành viên offline.",
        "tags": ["message"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["conversationId"],
                "properties": {
                  "conversationId": { "type": "string", "example": "664a1b2c3d4e5f6a7b8c9d0e" },
                  "content": { "type": "string" },
                  "imgUrl": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": { "type": "string" },
                        "fileType": { "type": "string", "enum": ["image", "video", "file"] },
                        "name": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Gửi tin nhắn nhóm thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "$ref": "#/components/schemas/Message" }
                  }
                }
              }
            }
          },
          "400": { "description": "Thiếu conversationId hoặc nội dung" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/message/{messageId}/update": {
      "patch": {
        "summary": "Chỉnh sửa nội dung tin nhắn",
        "description": "Chỉ người GỬI tin nhắn mới có quyền chỉnh sửa. Sau khi sửa, backend phát socket 'update-message'.",
        "tags": ["message"],
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID của tin nhắn cần chỉnh sửa"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": { "type": "string", "example": "Nội dung đã chỉnh sửa" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chỉnh sửa tin nhắn thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "$ref": "#/components/schemas/Message" }
                  }
                }
              }
            }
          },
          "400": { "description": "Nội dung rỗng hoặc không có quyền chỉnh sửa" },
          "404": { "description": "Không tìm thấy tin nhắn" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/message/{messageId}/delete": {
      "patch": {
        "summary": "Thu hồi tin nhắn",
        "description": "Chỉ người GỬI mới có quyền thu hồi. Tin nhắn được đánh dấu isDelete=true, không xóa khỏi database. Backend phát socket 'delete-message'.",
        "tags": ["message"],
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID của tin nhắn cần thu hồi"
          }
        ],
        "responses": {
          "200": {
            "description": "Thu hồi tin nhắn thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "$ref": "#/components/schemas/Message" }
                  }
                }
              }
            }
          },
          "400": { "description": "Không có quyền thu hồi (phải là người gửi)" },
          "404": { "description": "Không tìm thấy tin nhắn" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/message/upload": {
      "post": {
        "summary": "Upload file đính kèm cho tin nhắn",
        "description": "Upload ảnh/video/file lên Cloudinary. Tối đa 10 file, mỗi file tối đa 100MB. Trả về mảng URL để gửi kèm tin nhắn.",
        "tags": ["message"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["imgUrl"],
                "properties": {
                  "imgUrl": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" },
                    "description": "Các file muốn upload (ảnh, video, file)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload thành công, trả về mảng thông tin file",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "imgUrl": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/MessageImage" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/conversation": {
      "post": {
        "summary": "Tạo hội thoại mới",
        "description": "Tạo direct (1-1) hoặc group conversation. Nếu direct đã tồn tại sẽ trả về conversation cũ. Khi tạo group, backend phát socket 'new-group' đến tất cả thành viên.",
        "tags": ["conversation"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "memberIds"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["direct", "group"],
                    "description": "Loại hội thoại"
                  },
                  "name": {
                    "type": "string",
                    "description": "Tên nhóm (bắt buộc nếu type = group)",
                    "example": "Nhóm bạn thân"
                  },
                  "memberIds": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Danh sách ID thành viên (không bao gồm bản thân)",
                    "example": ["664a1b2c...", "664a1b2d..."]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo conversation thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation": { "$ref": "#/components/schemas/Conversation" }
                  }
                }
              }
            }
          },
          "400": { "description": "Dữ liệu không hợp lệ hoặc thiếu tên nhóm" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      },
      "get": {
        "summary": "Lấy danh sách tất cả hội thoại của người dùng",
        "description": "Trả về các conversation được sắp xếp theo lastMessageAt giảm dần.",
        "tags": ["conversation"],
        "responses": {
          "200": {
            "description": "Danh sách conversation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Conversation" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/conversation/{conversationId}/message": {
      "get": {
        "summary": "Lấy lịch sử tin nhắn trong hội thoại",
        "description": "Phân trang bằng cursor-based pagination. Truyền cursor để load thêm tin nhắn cũ hơn.",
        "tags": ["conversation"],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID của conversation"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 },
            "description": "Số lượng tin nhắn mỗi lần load"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date-time" },
            "description": "Mốc thời gian createdAt để load tin nhắn cũ hơn (lấy từ nextCursor của response trước)"
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách tin nhắn và con trỏ phân trang",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Message" }
                    },
                    "nextCursor": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true,
                      "description": "Truyền vào cursor lần sau để load thêm. null = đã hết tin nhắn"
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/conversation/{conversationId}/seen": {
      "patch": {
        "summary": "Đánh dấu đã đọc toàn bộ tin nhắn trong hội thoại",
        "description": "Set unreadCounts của user về 0. Backend phát socket 'read-message' đến tất cả thành viên.",
        "tags": ["conversation"],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Đánh dấu đã đọc thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Mark As Seen" },
                    "seenBy": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "unreadCounts": { "type": "integer", "example": 0 }
                  }
                }
              }
            }
          },
          "404": { "description": "Conversation không tồn tại hoặc chưa có tin nhắn" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    },
    "/conversation/{conversationId}/delete": {
      "patch": {
        "summary": "Xóa hội thoại (chỉ ẩn phía người dùng)",
        "description": "Soft delete: đánh dấu deletedAt cho user này. Các thành viên khác vẫn thấy conversation bình thường. Tin nhắn cũ hơn deletedAt sẽ bị ẩn.",
        "tags": ["conversation"],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Xóa conversation thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Xóa cuộc hội thoại thành công" },
                    "conversation": { "$ref": "#/components/schemas/Conversation" }
                  }
                }
              }
            }
          },
          "404": { "description": "Conversation không tồn tại" },
          "401": { "description": "Chưa đăng nhập" },
          "500": { "description": "Lỗi hệ thống" }
        }
      }
    }
  }
}
